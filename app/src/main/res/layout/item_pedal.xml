<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <!-- Card container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:elevation="4dp"
        android:clipToOutline="true">

        <!-- Header row — always visible, tap to expand/collapse -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <!-- Color accent strip -->
            <View
                android:id="@+id/accentStrip"
                android:layout_width="6dp"
                android:layout_height="34dp"
                android:layout_marginEnd="16dp"/>

            <!-- Pedal name -->
            <TextView
                android:id="@+id/tvPedalName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="#FFFFFF"/>

            <!-- Chevron indicator -->
            <TextView
                android:id="@+id/tvChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textSize="18sp"
                android:textColor="#5A5A5A"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <!-- Thin divider (visible only when expanded) -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2C2C2C"
            android:visibility="gone"/>

        <!-- Expandable content -->
        <LinearLayout
            android:id="@+id/expandedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="22dp"
            android:visibility="gone">

            <!-- Lines container — TextViews added programmatically -->
            <LinearLayout
                android:id="@+id/linesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Edit button -->
            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="EDITAR"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
